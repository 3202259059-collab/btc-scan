# ---- 分析（必填，否则退化为纯数据播报）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 推送（配了哪个发哪个，可多选）----
# Telegram：找 @BotFather 建 bot，chat_id 找 @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bark（iPhone，App Store 搜 Bark，复制自己的 URL，形如 https://api.day.app/xxxxxx）
BARK_URL=

# 飞书群机器人 webhook
FEISHU_WEBHOOK=

# Server酱（微信推送，https://sct.ftqq.com 取 SendKey）
SERVERCHAN_KEY=

# 邮件（SMTP_SSL）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
